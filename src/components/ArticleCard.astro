---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  href: string;
  cover: ImageMetadata;
  category?: string;
  readTime?: string;
}
const { title, href, cover, category, readTime } = Astro.props;
---

<article class="post" data-reveal="fan">
  <a href={href} class="post__link">
    <div class="post__media media">
      <Image
        src={cover}
        alt=""
        widths={[360, 560, 800]}
        sizes="(min-width: 900px) 30vw, (min-width: 600px) 46vw, 92vw"
        loading="lazy"
      />
      {category && <span class="post__chip">{category}</span>}
    </div>
    {readTime && <p class="post__meta">{readTime}</p>}
    <h3 class="post__title">{title}</h3>
    <span class="post__more">
      Explore Article
      <span class="post__icon"><Icon name="arrow-ur" /></span>
    </span>
  </a>
</article>

<style>
  .post__link {
    display: grid;
    gap: 12px;
  }
  .post__media {
    aspect-ratio: 1 / 1;
    border-radius: var(--r-md);
  }
  .post__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .post__link:hover .post__media :global(img) {
    transform: scale(1.06);
  }
  .post__chip {
    position: absolute;
    left: 10px;
    top: 10px;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: rgba(60, 30, 18, 0.62);
    color: var(--white);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: translate 0.45s var(--ease);
  }
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .post__chip {
      background: rgba(255, 255, 255, 0.2);
      -webkit-backdrop-filter: blur(12px) saturate(1.3);
      backdrop-filter: blur(12px) saturate(1.3);
    }
  }
  .post__link:hover .post__chip {
    translate: 4px 4px;
  }
  .post__meta {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .post__title {
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .post__icon {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--rust);
    color: var(--white);
    transition: transform 0.45s var(--ease);
  }
  .post__icon :global(svg) {
    width: 13px;
    height: 13px;
  }
  .post__link:hover .post__icon {
    transform: rotate(45deg);
  }
</style>
