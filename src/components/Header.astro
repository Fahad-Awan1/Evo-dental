---
import Logo from './Logo.astro';
import Roll from './Roll.astro';
import Icon from './Icon.astro';
import { nav, site, hoursText } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const weekdays = site.hours[0];
---

<header class="header" data-header>
  <div class="header__bar">
    <a href="/" class="header__logo" aria-label="Evo Dental home"><Logo /></a>

    <nav class="header__nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['header__link', { 'is-active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <Roll text={item.label} />
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <a href="/contact/" class="header__cta">
        <Roll text="Let's Get You Smiling" />
        <span class="header__cta-icon"><Icon name="arrow-ur" /></span>
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="nav-overlay" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <span class="burger__lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<!-- Phone and tablet menu: a slide in drawer from the right -->
<div class="drawer" id="nav-overlay" data-nav-overlay hidden>
  <div class="drawer__backdrop" data-nav-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <nav class="drawer__links" aria-label="Mobile">
      {
        nav.map((item, i) => (
          <a
            href={item.href}
            class:list={['drawer__link', { 'is-active': isActive(item.href) }]}
            style={`--i:${i}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="drawer__num">0{i + 1}</span>
            <span class="drawer__label">{item.label}</span>
            <span class="drawer__chev"><Icon name="arrow" /></span>
          </a>
        ))
      }
    </nav>
    <div class="drawer__foot" style={`--i:${nav.length}`}>
      <a href="/contact/" class="btn btn--primary drawer__book">
        Book Appointment <span class="btn__icon"><Icon name="arrow" /></span>
      </a>
      <a href={site.phoneHref} class="drawer__row"><Icon name="phone" />{site.phone}</a>
      <p class="drawer__row"><Icon name="clock" />{weekdays.label}: {hoursText(weekdays)}</p>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 900;
    padding: 10px var(--pad) 0;
    transition: transform 0.5s var(--ease);
    pointer-events: none;
  }
  .header__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: var(--maxw);
    height: calc(var(--header-h) - 12px);
    margin-inline: auto;
    padding: 0 10px 0 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0);
    transition:
      background-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .header.is-scrolled .header__bar,
  :global(html.nav-open) .header__bar {
    background: rgba(255, 255, 255, 0.86);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 6px 30px rgba(19, 17, 16, 0.08);
  }
  .header.is-hidden {
    transform: translateY(-110%);
  }
  :global(html.nav-open) .header {
    transform: none;
  }
  .header__logo {
    display: inline-flex;
    padding: 6px 0;
  }
  .header__nav {
    display: none;
    gap: clamp(18px, 2.2vw, 34px);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .header__link {
    position: relative;
    padding: 10px 0;
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rust);
    transform: translateX(-50%) scale(0);
    transition: transform 0.4s var(--ease);
  }
  .header__link.is-active::after {
    transform: translateX(-50%) scale(1);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header__cta {
    display: none;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .header__cta-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--rust);
    color: var(--white);
    transition: transform 0.45s var(--ease);
  }
  .header__cta-icon :global(svg) {
    width: 17px;
    height: 17px;
  }
  .header__cta:hover .header__cta-icon {
    transform: rotate(45deg);
  }
  .burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--rust);
    color: var(--white);
    transition: background-color 0.3s;
  }
  .burger__lines {
    position: relative;
    width: 18px;
    height: 10px;
  }
  .burger__lines i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .burger__lines i:first-child {
    top: 0;
  }
  .burger__lines i:last-child {
    bottom: 0;
  }
  .burger[aria-expanded='true'] .burger__lines i:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__lines i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* ---------- Drawer ---------- */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 890;
  }
  .drawer[hidden] {
    display: none;
  }
  .drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(19, 17, 16, 0.4);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }
  .drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    width: min(86vw, 400px);
    padding: calc(var(--header-h) + 20px) 22px max(24px, env(safe-area-inset-bottom));
    overflow-y: auto;
    border-radius: var(--r-lg) 0 0 var(--r-lg);
    background: var(--white);
    box-shadow: -20px 0 60px rgba(19, 17, 16, 0.18);
    transform: translateX(104%);
    transition: transform 0.55s var(--ease);
  }
  .drawer.is-open .drawer__backdrop {
    opacity: 1;
  }
  .drawer.is-open .drawer__panel {
    transform: none;
  }
  .drawer__links {
    display: grid;
    gap: 4px;
  }
  .drawer__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 10px 14px 10px 16px;
    border-radius: 16px;
    font-size: 1.25rem;
    font-weight: 500;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .drawer__num {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--rust);
  }
  .drawer__chev {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--card);
    color: var(--rust);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .drawer__chev :global(svg) {
    width: 16px;
    height: 16px;
  }
  .drawer__link.is-active {
    background: var(--cream);
  }
  .drawer__link.is-active .drawer__chev,
  .drawer__link:active .drawer__chev {
    background: var(--rust);
    color: var(--white);
  }
  .drawer__foot {
    display: grid;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .drawer__book {
    justify-content: space-between;
    width: 100%;
  }
  .drawer__row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .drawer__row :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--rust);
  }

  /* links slide in one after another once the panel is open */
  .drawer__link,
  .drawer__foot {
    opacity: 0;
    transform: translateX(24px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .drawer.is-open .drawer__link,
  .drawer.is-open .drawer__foot {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.2s + var(--i) * 0.05s);
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }
    .burger {
      display: none;
    }
    .header__cta {
      display: inline-flex;
    }
    .drawer {
      display: none !important;
    }
  }
  @media (min-width: 480px) and (max-width: 1023px) {
    .header__cta {
      display: inline-flex;
    }
    .header__cta :global(.roll) {
      display: none;
    }
  }
</style>
