---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Roll from './Roll.astro';
import { site } from '../data/site';

const columns = [
  {
    title: 'General',
    links: [
      { label: 'Home', href: '/' },
      { label: 'About Us', href: '/about/' },
      { label: 'Services', href: '/services/' },
      { label: 'Our Team', href: '/team/' },
    ],
  },
  {
    title: 'Treatments',
    links: [
      { label: 'Dental Implants', href: '/services/dental-implants/' },
      { label: 'Invisalign', href: '/services/invisalign/' },
      { label: 'Teeth Whitening', href: '/services/teeth-whitening/' },
      { label: 'Emergency Care', href: '/services/emergency-dentistry/' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Blog', href: '/blog/' },
      { label: 'Book A Visit', href: '/contact/' },
      { label: 'FAQs', href: '/services/#faq' },
    ],
  },
];
---

<footer class="footer on-rust">
  <svg class="footer__word footer__word--ghost" viewBox="0 0 1000 150" aria-hidden="true" focusable="false">
    <text x="500" y="146" text-anchor="middle" textLength="992" lengthAdjust="spacingAndGlyphs">EVO DENTAL</text>
  </svg>
  <svg class="footer__word footer__word--outline" viewBox="0 0 1000 150" aria-hidden="true" focusable="false">
    <text x="500" y="146" text-anchor="middle" textLength="992" lengthAdjust="spacingAndGlyphs">EVO DENTAL</text>
  </svg>

  <div class="footer__card">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" aria-label="Evo Dental home"><Logo /></a>
        <p>We believe that visiting the dentist should be a calm, comfortable and positive experience.</p>
        <ul class="footer__socials">
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                  <Icon name={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="footer__cols">
        {
          columns.map((col) => (
            <div class="footer__col">
              <h2>{col.title}</h2>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>
                      <Roll text={l.label} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div class="footer__bottom">
      <p>&copy; <span data-year>2026</span> Evo Dental. All rights reserved.</p>
      <div class="footer__legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms Of Use</a>
      </div>
    </div>
  </div>

  <svg class="footer__word footer__word--solid" viewBox="0 0 1000 150" aria-hidden="true" focusable="false">
    <text x="500" y="146" text-anchor="middle" textLength="992" lengthAdjust="spacingAndGlyphs">EVO DENTAL</text>
  </svg>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    margin: 0 clamp(8px, 1.2vw, 16px) clamp(8px, 1.2vw, 16px);
    padding: clamp(56px, 11vw, 150px) var(--pad) 0;
    border-radius: var(--r-lg);
    background: var(--rust);
    color: var(--white);
    --logo-bg: var(--rust);
    --logo-accent: var(--white);
  }
  .footer__word {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: none;
    user-select: none;
  }
  .footer__word text {
    font-size: 200px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .footer__word--ghost,
  .footer__word--outline {
    position: absolute;
    left: var(--pad);
    width: calc(100% - 2 * var(--pad));
  }
  .footer__word--ghost {
    top: clamp(10px, 1.6vw, 26px);
    fill: rgba(255, 255, 255, 0.16);
  }
  .footer__word--outline {
    display: none;
    top: 50%;
    transform: translateY(-50%);
    fill: none;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 1.2;
  }
  .footer__word--solid {
    position: relative;
    z-index: 0;
    margin-top: clamp(-56px, -3.6vw, -6px);
    margin-bottom: -1.2%;
    fill: var(--white);
  }
  @media (min-width: 700px) {
    .footer__word--outline {
      display: block;
    }
  }
  .footer__card {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin-inline: auto;
    padding: clamp(22px, 3.4vw, 44px);
    border: 1.5px solid rgba(255, 255, 255, 0.85);
    border-radius: var(--r-lg);
    background: var(--rust);
    box-shadow: 0 30px 60px rgba(60, 22, 8, 0.28);
  }
  .footer__top {
    display: grid;
    gap: 32px;
  }
  .footer__brand p {
    max-width: 34ch;
    margin-top: 16px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .footer__socials {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .footer__socials :global(svg) {
    width: 18px;
    height: 18px;
  }
  .footer__socials a:hover {
    background: var(--white);
    color: var(--rust);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 20px;
  }
  .footer__col h2 {
    margin-bottom: 12px;
    font-size: 1rem;
    font-weight: 600;
  }
  .footer__col li + li {
    margin-top: 2px;
  }
  .footer__col a {
    display: inline-block;
    padding: 5px 0;
    font-size: 0.93rem;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.3s;
  }
  .footer__col a:hover {
    color: var(--white);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.88rem;
  }
  .footer__legal {
    display: flex;
    gap: 22px;
  }
  .footer__legal a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    .footer__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr);
      gap: 48px;
    }
  }
</style>
