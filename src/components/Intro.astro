---
// Home page intro: scroll-filled heading, trust chips and an animated bento of
// photo and stat tiles. Motion hooks live in scripts/app.ts:
//   data-inview  adds .is-in once the element scrolls into view
//   data-fill    sets --p (0 to 1) from scroll position
//   data-spot    sets --mx / --my from the pointer
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Roll from './Roll.astro';
import CircleBadge from './CircleBadge.astro';
import { site } from '../data/site';
import { testimonials } from '../data/content';
import introModel from '../assets/images/intro-model.jpg';
import introPatient from '../assets/images/intro-patient.jpg';

const words = ['Transforming', 'dental', 'visits', 'into', 'comfortable.'];
const [patients, years, specialists, recommend] = site.stats;
const chips = ['Same day emergency care', 'Sedation for nervous patients', '3D digital scanning'];
const TOOTH =
  'M24 9c-3.2 0-5.2-2-9-2C9.6 7 6 11.2 6 16.8c0 4.6 1.9 7.6 3 11.6 1.2 4.4 1.3 9.3 2.8 12.5.8 1.7 3.2 1.6 3.9-.2 1.4-3.7 1.5-10.7 8.3-10.7s6.900 7 8.300 10.700c.7 1.800 3.100 1.900 3.900.2 1.500-3.200 1.600-8.100 2.800-12.500 1.100-4 3-7 3-11.600C42 11.200 38.400 7 33 7c-3.800 0-5.800 2-9 2z';
---

<section class="section intro" aria-labelledby="intro-title">
  <div class="container">
    <div class="intro__head">
      <div>
        <p class="eyebrow" data-reveal>Why Evo Dental</p>
        <h2 class="h-section intro__title" id="intro-title" data-inview data-fill style={`--n:${words.length}`}>
          {
            words.map((word, i) => (
              <>
                <span class:list={['intro__word', { 'intro__word--accent': i === words.length - 1 }]} style={`--i:${i}`}>
                  <span>{word}</span>
                </span>{' '}
              </>
            ))
          }
        </h2>
      </div>

      <div class="intro__side">
        <p class="lede" data-reveal>
          That's why we've made it our mission to transform dental care into a calming, stress-free experience. From
          the moment you walk through our doors, you'll be greeted by a warm, friendly team.
        </p>
        <ul class="intro__chips" data-inview>
          {
            chips.map((chip, i) => (
              <li style={`--i:${i}`}>
                <Icon name="check" />
                {chip}
              </li>
            ))
          }
        </ul>
        <a href="/about/" class="intro__more" data-reveal>
          <Roll text="More about us" />
          <span class="intro__more-icon"><Icon name="arrow-ur" /></span>
        </a>
      </div>
    </div>

    <div class="intro__grid" data-inview>
      <div class="intro__col">
        <a href="/services/braces/" class="intro__tile intro__tile--photo" style="--i:0; --r:-4deg">
          <span class="intro__frame">
            <Image
              src={introModel}
              alt="Dental model fitted with braces"
              widths={[320, 520, 760]}
              sizes="(min-width: 900px) 24vw, 46vw"
              loading="lazy"
              data-parallax="0.1"
            />
          </span>
          <span class="intro__tag">
            Orthodontics
            <span class="intro__tag-icon"><Icon name="arrow-ur" /></span>
          </span>
        </a>

        <a href="/contact/" class="intro__tile intro__mini" style="--i:1; --r:3deg">
          <span>
            <small>New here?</small>
            <strong>Book your first visit</strong>
          </span>
          <span class="intro__arrow"><Icon name="arrow-ur" /></span>
        </a>
      </div>

      <div class="intro__tile intro__stat" style="--i:2; --r:2deg" data-spot>
        <svg class="intro__outline" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
          <path pathLength="1" d={TOOTH}></path>
        </svg>
        <div class="intro__faces" aria-hidden="true">
          {
            testimonials.map((t, i) => (
              <span style={`--i:${i}`}>
                <Image src={t.photo} alt="" width={72} height={72} loading="lazy" />
              </span>
            ))
          }
          <span class="intro__faces-more" style={`--i:${testimonials.length}`}>
            <Icon name="plus" />
          </span>
        </div>
        <p class="intro__count">
          <strong>
            <span data-count={patients.value}>{patients.value.toLocaleString('en-US')}</span>{patients.suffix}
          </strong>
          <span>{patients.label}</span>
        </p>
        <div class="intro__meter">
          <span class="intro__bar" style={`--v:${recommend.value / 100}`}><i></i></span>
          <span class="intro__meter-label">{recommend.value}{recommend.suffix} recommend us</span>
        </div>
      </div>

      <a href="/about/" class="intro__tile intro__tile--wide" style="--i:3; --r:-2deg">
        <span class="intro__frame">
          <Image
            src={introPatient}
            alt="Patient laughing with a dentist in the treatment chair"
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 42vw, 92vw"
            loading="lazy"
            data-parallax="0.1"
          />
        </span>
        <span class="intro__pill intro__float">
          <span class="intro__stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
          {site.rating.value} from {site.rating.count}+ reviews
        </span>
        <span class="intro__caption">
          <span>
            <strong>Gentle care, every visit</strong>
            <small>Meet the people behind it</small>
          </span>
          <span class="intro__arrow"><Icon name="arrow-ur" /></span>
        </span>
        <span class="intro__sticker" aria-hidden="true">
          <CircleBadge id="intro-ring" text="Gentle · Modern · Trusted · " repeat={2} size={15.5} />
          <Icon name="tooth" />
        </span>
      </a>
    </div>

    <ul class="intro__numbers">
      <li data-reveal>
        <strong><span data-count={years.value}>{years.value}</span>{years.suffix}</strong>
        <span>{years.label}</span>
      </li>
      <li data-reveal>
        <strong><span data-count={specialists.value}>{specialists.value}</span>{specialists.suffix}</strong>
        <span>{specialists.label}</span>
      </li>
      <li data-reveal>
        <strong><span data-count={site.rating.value} data-decimals="1">{site.rating.value}</span></strong>
        <span>Average Patient Rating</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .intro {
    position: relative;
    overflow: clip;
  }
  /* soft cream wash behind the tiles */
  .intro::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 34%;
    width: min(1100px, 120vw);
    aspect-ratio: 1.6;
    background: radial-gradient(closest-side, var(--cream), transparent);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .intro > .container {
    position: relative;
  }

  /* ---------- Head ---------- */
  .intro__head {
    display: grid;
    gap: 22px;
    margin-bottom: clamp(28px, 4vw, 52px);
  }
  .intro__title {
    margin-top: 14px;
    max-width: 17ch;
    text-wrap: wrap;
  }
  .intro__word {
    display: inline-block;
    overflow: clip;
    padding: 0.04em 0.02em 0.06em 0;
    margin-bottom: -0.1em;
    vertical-align: bottom;
    /* scroll fill: each word goes from grey to ink as --p passes its index */
    color: color-mix(
      in srgb,
      var(--word, var(--ink)) calc(clamp(0, var(--p, 1) * (var(--n) + 0.6) - var(--i), 1) * 100%),
      #cfc9c3
    );
  }
  .intro__word--accent {
    --word: var(--rust);
    padding-right: 0.1em;
    font-style: italic;
    font-weight: 700;
  }
  .intro__word > span {
    display: inline-block;
  }
  :global(html.fx) .intro__title .intro__word > span {
    translate: 0 115%;
  }
  :global(html.fx) .intro__title:global(.is-in) .intro__word > span {
    translate: 0 0;
    transition: translate 1s var(--ease) calc(var(--i) * 70ms);
  }

  .intro__side {
    display: grid;
    gap: 18px;
    justify-items: start;
    align-content: start;
  }
  .intro__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .intro__chips li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 6px 14px 6px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-size: 0.88rem;
    font-weight: 500;
  }
  .intro__chips :global(svg) {
    width: 22px;
    height: 22px;
    padding: 4px;
    border-radius: 50%;
    background: var(--rust);
    color: var(--white);
  }
  :global(html.fx) .intro__chips li {
    opacity: 0;
    scale: 0.8;
    translate: 0 12px;
  }
  :global(html.fx) .intro__chips:global(.is-in) li {
    opacity: 1;
    scale: 1;
    translate: 0 0;
    transition:
      opacity 0.6s var(--ease) calc(0.15s + var(--i) * 90ms),
      scale 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.15s + var(--i) * 90ms),
      translate 0.7s var(--ease) calc(0.15s + var(--i) * 90ms);
  }
  .intro__more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-weight: 500;
  }
  .intro__more-icon,
  .intro__arrow,
  .intro__tag-icon {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    background: var(--rust);
    color: var(--white);
    transition:
      rotate 0.45s var(--ease),
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .intro__more-icon {
    width: 34px;
    height: 34px;
  }
  .intro__more-icon :global(svg) {
    width: 15px;
    height: 15px;
  }
  .intro__more:hover .intro__more-icon {
    rotate: 45deg;
  }

  /* ---------- Bento ---------- */
  .intro__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .intro__col {
    display: contents;
  }
  .intro__tile {
    position: relative;
    display: block;
    border-radius: var(--r-md);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  :global(html.fx) .intro__grid .intro__tile {
    opacity: 0;
    translate: 0 70px;
    rotate: var(--r, -3deg);
  }
  :global(html.fx) .intro__grid:global(.is-in) .intro__tile {
    opacity: 1;
    translate: 0 0;
    rotate: 0deg;
    transition:
      opacity 0.9s var(--ease) calc(var(--i) * 0.11s),
      translate 1.1s var(--ease) calc(var(--i) * 0.11s),
      rotate 1.1s var(--ease) calc(var(--i) * 0.11s),
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .intro__tile:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 48px rgba(127, 59, 33, 0.16);
    }
  }

  /* photo tiles */
  .intro__tile--photo {
    aspect-ratio: 4 / 5;
  }
  .intro__tile--wide {
    grid-column: 1 / -1;
    order: 3;
    aspect-ratio: 16 / 11;
  }
  .intro__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--card);
  }
  .intro__frame :global(img) {
    position: absolute;
    left: 0;
    top: -8%;
    width: 100%;
    height: 116%; /* headroom for the scroll parallax */
    object-fit: cover;
    transition: scale 1.2s var(--ease);
  }
  :global(html.fx) .intro__grid .intro__frame :global(img) {
    scale: 1.25;
  }
  :global(html.fx) .intro__grid:global(.is-in) .intro__frame :global(img) {
    scale: 1;
    transition: scale 1.6s var(--ease) calc(var(--i) * 0.11s);
  }
  .intro__grid .intro__tile:hover .intro__frame :global(img),
  :global(html.fx) .intro__grid:global(.is-in) .intro__tile:hover .intro__frame :global(img) {
    scale: 1.07;
    transition: scale 1.2s var(--ease);
  }
  .intro__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(30, 12, 4, 0) 45%, rgba(30, 12, 4, 0.5));
  }

  .intro__tag,
  .intro__pill,
  .intro__caption {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(60, 30, 18, 0.6);
    color: var(--white);
  }
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .intro__tag,
    .intro__pill,
    .intro__caption {
      background: rgba(255, 255, 255, 0.18);
      -webkit-backdrop-filter: blur(14px) saturate(1.3);
      backdrop-filter: blur(14px) saturate(1.3);
    }
  }
  .intro__tag {
    left: 10px;
    right: 10px;
    bottom: 10px;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 6px 6px 14px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .intro__tag-icon {
    width: 30px;
    height: 30px;
    background: var(--white);
    color: var(--rust);
  }
  .intro__tag-icon :global(svg),
  .intro__arrow :global(svg) {
    width: 15px;
    height: 15px;
  }
  .intro__tile:hover .intro__tag-icon,
  .intro__tile:hover .intro__arrow {
    rotate: 45deg;
  }
  .intro__pill {
    left: 12px;
    top: 12px;
    gap: 8px;
    padding: 7px 14px 7px 10px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .intro__stars {
    display: inline-flex;
    color: #ffd27a;
  }
  .intro__stars :global(svg) {
    width: 13px;
    height: 13px;
  }
  .intro__caption {
    left: 12px;
    bottom: 12px;
    max-width: calc(100% - 24px);
    gap: 16px;
    padding: 10px 10px 10px 16px;
    border-radius: 18px;
  }
  .intro__caption > span:first-child {
    display: grid;
    line-height: 1.25;
  }
  .intro__caption strong {
    font-size: 0.98rem;
    font-weight: 600;
  }
  .intro__caption small {
    font-size: 0.8rem;
    opacity: 0.85;
  }
  .intro__arrow {
    width: 40px;
    height: 40px;
  }
  .intro__caption .intro__arrow {
    background: var(--white);
    color: var(--rust);
  }
  .intro__float {
    animation: intro-float 5.5s ease-in-out infinite;
  }
  @keyframes intro-float {
    50% {
      transform: translateY(-7px);
    }
  }
  .intro__sticker {
    position: absolute;
    z-index: 2;
    right: 8px;
    top: -16px;
    display: grid;
    place-items: center;
    width: 70px;
    aspect-ratio: 1;
    padding: 6px;
    border-radius: 50%;
    background: var(--cream);
    color: var(--rust);
    box-shadow: 0 10px 28px rgba(127, 59, 33, 0.22);
  }
  .intro__sticker > :global(svg:last-child) {
    position: absolute;
    width: 30%;
    height: 30%;
  }
  :global(html.fx) .intro__grid .intro__sticker {
    scale: 0;
    rotate: -90deg;
  }
  :global(html.fx) .intro__grid:global(.is-in) .intro__sticker {
    scale: 1;
    rotate: 0deg;
    transition:
      scale 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.75s,
      rotate 1.1s var(--ease) 0.75s;
  }

  /* cream call to action card */
  .intro__mini {
    grid-column: 1 / -1;
    order: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 16px 16px 20px;
    background: var(--cream);
  }
  .intro__mini > span:first-child {
    display: grid;
    line-height: 1.25;
  }
  .intro__mini small {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .intro__mini strong {
    font-size: 1.1rem;
    font-weight: 600;
  }

  /* stat tile */
  .intro__stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: clamp(14px, 2vw, 24px);
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(155deg, var(--rust-soft), var(--rust) 45%, var(--rust-deep));
    color: var(--white);
  }
  /* glow that follows the pointer (data-spot) */
  .intro__stat::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(220px circle at var(--mx, 75%) var(--my, 12%), rgba(255, 255, 255, 0.26), transparent 65%);
  }
  /* slow drifting warm blob */
  .intro__stat::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: -30%;
    bottom: -35%;
    width: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 196, 150, 0.45), transparent);
    animation: intro-drift 9s ease-in-out infinite alternate;
  }
  @keyframes intro-drift {
    to {
      transform: translate(70%, -60%) scale(1.25);
    }
  }
  .intro__outline {
    position: absolute;
    z-index: -1;
    right: -14%;
    top: -6%;
    width: 78%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 0.5;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    rotate: 12deg;
  }
  :global(html.fx) .intro__grid .intro__outline {
    stroke-dashoffset: 1;
  }
  :global(html.fx) .intro__grid:global(.is-in) .intro__outline {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2.2s var(--ease-io) 0.5s;
  }
  .intro__faces {
    display: flex;
    padding-left: 8px;
  }
  .intro__faces > span {
    width: clamp(30px, 3.2vw, 40px);
    aspect-ratio: 1;
    margin-left: -8px;
    overflow: hidden;
    border: 2px solid var(--rust);
    border-radius: 50%;
    background: var(--cream);
  }
  .intro__faces :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .intro__faces-more {
    display: grid;
    place-items: center;
    color: var(--rust);
  }
  .intro__faces-more :global(svg) {
    width: 50%;
    height: 50%;
  }
  :global(html.fx) .intro__grid .intro__faces > span {
    scale: 0;
  }
  :global(html.fx) .intro__grid:global(.is-in) .intro__faces > span {
    scale: 1;
    transition: scale 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.55s + var(--i) * 90ms);
  }
  .intro__count {
    display: grid;
    margin-top: auto;
  }
  .intro__count strong {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .intro__count > span {
    margin-top: 6px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.86);
  }
  .intro__meter {
    display: grid;
    gap: 7px;
  }
  .intro__bar {
    display: block;
    height: 5px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.24);
  }
  .intro__bar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--white);
    transform: scaleX(var(--v));
    transform-origin: 0 50%;
  }
  :global(html.fx) .intro__grid .intro__bar i {
    transform: scaleX(0);
  }
  :global(html.fx) .intro__grid:global(.is-in) .intro__bar i {
    transform: scaleX(var(--v));
    transition: transform 1.6s var(--ease-io) 0.7s;
  }
  .intro__meter-label {
    font-size: 0.78rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.9);
  }

  /* ---------- Numbers strip ---------- */
  .intro__numbers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(28px, 4vw, 52px);
    border-top: 1px solid var(--line);
  }
  .intro__numbers li {
    display: grid;
    gap: 4px;
    padding: clamp(16px, 2.4vw, 28px) 8px 0 clamp(10px, 2vw, 28px);
    border-left: 1px solid var(--line);
  }
  .intro__numbers li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .intro__numbers strong {
    font-size: clamp(1.7rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--rust);
  }
  .intro__numbers li > span {
    font-size: clamp(0.78rem, 1.1vw, 0.95rem);
    line-height: 1.3;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .intro__head {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: end;
      gap: 48px;
    }
    .intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.75fr);
      max-width: 1120px;
      margin-inline: auto;
    }
    .intro__col {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .intro__tile--photo {
      aspect-ratio: 1;
    }
    .intro__mini {
      flex: 1;
      order: 0;
      min-height: 96px;
    }
    .intro__tile--wide {
      grid-column: auto;
      order: 0;
      aspect-ratio: auto;
    }
    .intro__pill {
      left: 16px;
      top: 16px;
      font-size: 0.85rem;
    }
    .intro__caption {
