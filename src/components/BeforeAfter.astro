---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import smile from '../assets/images/smile-result.jpg';
---

<section class="section ba">
  <div class="container ba__grid">
    <div class="ba__text">
      <p class="eyebrow" data-reveal>Before &amp; After</p>
      <h2 class="h-section" data-split>See the difference a visit makes</h2>
      <p class="lede" data-reveal>
        Drag the slider to compare. Professional whitening lifts years of staining in about an hour, and it is one of
        the simplest ways to refresh your smile.
      </p>
      <div data-reveal><Button label="Explore Whitening" href="/services/teeth-whitening/" /></div>
    </div>

    <figure class="compare" data-compare data-reveal="right">
      <div class="compare__frame">
        <Image
          class="compare__img"
          src={smile}
          alt="Close-up of a smile after whitening"
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 52vw, 92vw"
          loading="lazy"
        />
        <div class="compare__before" aria-hidden="true">
          <Image
            class="compare__img"
            src={smile}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 52vw, 92vw"
            loading="lazy"
          />
        </div>
        <span class="compare__tag compare__tag--before" aria-hidden="true">Before</span>
        <span class="compare__tag compare__tag--after" aria-hidden="true">After</span>
        <div class="compare__handle" aria-hidden="true">
          <span>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path></svg>
          </span>
        </div>
        <input type="range" min="0" max="100" value="50" step="1" aria-label="Drag to compare before and after" />
      </div>
      <figcaption>Illustrative simulation of a whitening result. Real patient cases will replace it.</figcaption>
    </figure>
  </div>
</section>

<style>
  .ba__grid {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .ba__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .compare {
    --pos: 50%;
  }
  .compare__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    background: var(--card);
    user-select: none;
  }
  .compare :global(.compare__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .compare__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .compare__before :global(.compare__img) {
    filter: sepia(0.62) saturate(1.5) hue-rotate(-8deg) brightness(0.9) contrast(0.96);
  }
  .compare__tag {
    position: absolute;
    top: 14px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(19, 17, 16, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .compare__tag--before {
    left: 14px;
  }
  .compare__tag--after {
    right: 14px;
  }
  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--white);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .compare__handle span {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--white);
    color: var(--rust);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transform: translate(-50%, -50%);
  }
  .compare input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .compare__frame:has(input:focus-visible) .compare__handle span {
    outline: 3px solid var(--rust);
    outline-offset: 3px;
  }
  .compare figcaption {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .ba__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
</style>
