---
import Icon from './Icon.astro';
import { faqs, type Faq } from '../data/content';

interface Props {
  items?: Faq[];
  title?: string;
}
const { items = faqs, title = 'Questions, answered' } = Astro.props;
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <p class="eyebrow" data-reveal>FAQ</p>
      <h2 class="h-section" id="faq-title" data-split>{title}</h2>
      <p class="lede" data-reveal>
        Can't find what you need? Ask our assistant in the corner of the screen, or give us a call.
      </p>
    </div>
    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item" name="faq" data-reveal="left">
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon"><Icon name="plus" /></span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
  }
  .faq__head {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .faq__list {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .faq__item {
    border-radius: var(--r-md);
    background: var(--card);
    transition: background-color 0.4s var(--ease);
  }
  .faq__item[open] {
    background: var(--cream);
  }
  /* smooth open and close where the browser supports it; instant elsewhere */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 0.5s var(--ease),
      opacity 0.4s var(--ease),
      content-visibility 0.5s allow-discrete;
  }
  .faq__item[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 14px 14px 14px 22px;
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--white);
    color: var(--rust);
    transition:
      transform 0.45s var(--ease),
      background-color 0.3s,
      color 0.3s;
  }
  .faq__icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--rust);
    color: var(--white);
  }
  .faq__item p {
    padding: 0 22px 22px;
    max-width: 62ch;
    color: #4a4643;
  }
  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .faq__head {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
</style>
