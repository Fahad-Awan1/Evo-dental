---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { testimonials } from '../data/content';
import aside from '../assets/images/intro-patient.jpg';
---

<section class="section tst" aria-labelledby="tst-title">
  <div class="container">
    <div class="tst__head">
      <h2 class="h-section" id="tst-title" data-split>What our patients say</h2>
      <p class="lede" data-reveal>We take pride in creating healthy, confident smiles.</p>
    </div>

    <div class="tst__grid" data-slider>
      <div class="tst__photos media" data-slides data-reveal="left">
        {
          testimonials.map((t) => (
            <div class="tst__photo">
              <Image src={t.photo} alt={`${t.name}, ${t.treatment} patient`} widths={[400, 700]} sizes="(min-width: 900px) 30vw, 92vw" loading="lazy" />
            </div>
          ))
        }
      </div>

      <div class="tst__card" data-reveal="zoom">
        <span class="tst__mark"><Icon name="quote" /></span>
        <div class="tst__quotes" data-slides aria-live="polite">
          {
            testimonials.map((t) => (
              <blockquote class="tst__quote">
                <p>{t.quote}</p>
                <footer>
                  <strong>{t.name}</strong>
                  <span>{t.treatment}</span>
                </footer>
              </blockquote>
            ))
          }
        </div>
        <div class="tst__stars" role="img" aria-label="Rated 5 out of 5">
          {[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}
        </div>
      </div>

      <div class="tst__side" data-reveal="right">
        <div class="tst__aside media">
          <Image src={aside} alt="Patient laughing with a dentist during a visit" widths={[400, 700]} sizes="(min-width: 900px) 24vw, 92vw" loading="lazy" />
        </div>
        <div class="tst__nav">
          <button class="arrow-btn" type="button" aria-label="Previous review" data-slider-prev><Icon name="arrow-left" /></button>
          <button class="arrow-btn" type="button" aria-label="Next review" data-slider-next><Icon name="arrow" /></button>
          <span class="tst__status" data-slider-status aria-hidden="true">1 / {testimonials.length}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tst__head {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  .tst__head .h-section {
    max-width: 12ch;
  }
  .tst__grid {
    display: grid;
    gap: 16px;
  }
  .tst__photos {
    position: relative;
    aspect-ratio: 4 / 3.4;
    border-radius: var(--r-md);
  }
  .tst__photo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.7s var(--ease),
      transform 1.1s var(--ease);
  }
  .tst__photo:first-child,
  .tst__photo:global(.is-active) {
    opacity: 1;
    transform: none;
  }
  .tst__photos:has(:global(.is-active)) .tst__photo:not(:global(.is-active)) {
    opacity: 0;
    transform: scale(1.06);
  }
  .tst__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .tst__card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(20px, 2.4vw, 32px);
    border-radius: var(--r-md);
    background: var(--card);
  }
  .tst__mark {
    color: rgba(19, 17, 16, 0.12);
  }
  .tst__mark :global(svg) {
    width: 64px;
    height: 64px;
  }
  .tst__quotes {
    display: grid;
    flex: 1;
  }
  .tst__quote {
    grid-area: 1 / 1;
    display: grid;
    align-content: space-between;
    gap: 18px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease),
      visibility 0.5s;
  }
  .tst__quote:first-child,
  .tst__quote:global(.is-active) {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .tst__quotes:has(:global(.is-active)) .tst__quote:not(:global(.is-active)) {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
  }
  .tst__quote p {
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.5;
  }
  .tst__quote footer {
    display: grid;
    font-size: 0.92rem;
  }
  .tst__quote footer span {
    color: var(--muted);
  }
  .tst__stars {
    display: flex;
    gap: 2px;
    color: var(--rust);
  }
  .tst__stars :global(svg) {
    width: 18px;
    height: 18px;
  }
  .tst__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tst__aside {
    display: none;
    aspect-ratio: 4 / 3.4;
  }
  .tst__nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tst__nav .arrow-btn {
    width: 56px;
    height: 56px;
    color: var(--ink);
  }
  .tst__status {
    margin-left: 8px;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .tst__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .tst__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: stretch;
    }
    .tst__photos {
      aspect-ratio: auto;
      min-height: 420px;
    }
    .tst__aside {
      display: block;
    }
    .tst__side {
      justify-content: space-between;
    }
  }
</style>
