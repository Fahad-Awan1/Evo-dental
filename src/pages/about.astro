---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import clinic1 from '../assets/images/clinic-1.jpg';
import clinic2 from '../assets/images/clinic-2.jpg';
import clinic3 from '../assets/images/clinic-3.jpg';
import introPatient from '../assets/images/intro-patient.jpg';

const values = [
  { icon: 'shield', title: 'Prevention first', text: 'We would rather help you avoid a filling than place a perfect one. Every plan starts with keeping what is healthy.' },
  { icon: 'child', title: 'Comfort always', text: 'Numbing gel, gentle hands, sedation options and time to ask questions. Nobody is rushed and nobody is judged.' },
  { icon: 'sparkle', title: 'Honest advice', text: 'Clear options, clear prices and a written plan before treatment. You decide, with all the facts in front of you.' },
];
const tech = [
  { title: '3D digital scanning', text: 'A comfortable wand replaces messy impressions and shows your teeth on screen in seconds.' },
  { title: 'Low-dose digital X-rays', text: 'Sharper images with a fraction of the radiation of traditional film.' },
  { title: 'Guided implant surgery', text: 'Implants are planned virtually and placed through a custom guide for precision.' },
  { title: 'Hospital-grade sterilisation', text: 'Every instrument is tracked through a validated cleaning and sterilising cycle.' },
];
---

<Base title="About Us" description="Meet Evo Dental: a modern clinic built around calm, comfortable, honest dental care for the whole family.">
  <PageHero
    eyebrow="About Evo Dental"
    title="Dentistry that feels"
    em="different"
    lede="We opened Evo Dental with one aim: to make visiting the dentist something you no longer dread."
    model="tooth"
  />

  <section class="section story">
    <div class="container story__grid">
      <div class="media story__img" data-img-reveal>
        <Image src={introPatient} alt="A patient and dentist sharing a laugh in the treatment room" widths={[480, 800, 1200]} sizes="(min-width: 900px) 46vw, 92vw" loading="lazy" />
      </div>
      <div class="story__text">
        <p class="eyebrow" data-reveal>Our story</p>
        <h2 class="h-section" data-split>Calm, careful, and always on your side</h2>
        <p class="lede" data-reveal>
          Too many people avoid the dentist because of one bad experience. We built our clinic, our team and our whole
          way of working to change that.
        </p>
        <p data-reveal>
          From the first hello at reception to the follow-up call after treatment, everything is designed to be
          unhurried and clear. You will always know what we recommend, why, and what it costs before anything begins.
        </p>
        <div data-reveal><Button label="Meet The Team" href="/team/" /></div>
      </div>
    </div>
  </section>

  <section class="stats on-rust">
    <dl class="container stats__grid">
      {
        site.stats.map((s) => (
          <div class="stats__item" data-reveal="zoom">
            <dt>{s.label}</dt>
            <dd>
              <span data-count={s.value}>{s.value.toLocaleString('en-US')}</span>{s.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h-section values__title" data-split>What we believe in</h2>
      <div class="values">
        {
          values.map((v) => (
            <article class="values__card" data-reveal="flip" data-lift>
              <span class="values__icon"><Icon name={v.icon} /></span>
              <h3 class="h-card">{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="gallery__head">
        <h2 class="h-section" data-split>Our modern dental facilities</h2>
        <p class="lede" data-reveal>
          Bright treatment rooms, the latest diagnostic technology and a waiting area you will not mind waiting in.
        </p>
      </div>
      <div class="gallery">
        <div class="media gallery__a" data-img-reveal>
          <Image src={clinic1} alt="Modern treatment room with a dental chair" widths={[480, 900, 1400]} sizes="(min-width: 900px) 58vw, 92vw" loading="lazy" />
        </div>
        <div class="media gallery__b" data-img-reveal>
          <Image src={clinic2} alt="Dentist reviewing a 3D dental scan on a screen" widths={[400, 700, 1000]} sizes="(min-width: 900px) 36vw, 92vw" loading="lazy" />
        </div>
        <div class="media gallery__c" data-img-reveal>
          <Image src={clinic3} alt="Bright, comfortable waiting area" widths={[400, 700, 1000]} sizes="(min-width: 900px) 36vw, 92vw" loading="lazy" />
        </div>
      </div>
      <ul class="tech">
        {
          tech.map((t, i) => (
            <li data-reveal="left">
              <span class="tech__num">0{i + 1}</span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Testimonials />
  <CtaBand />
</Base>

<style>
  .story__grid {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .story__img {
    aspect-ratio: 4 / 3.4;
    border-radius: var(--r-lg);
  }
  .story__text {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .story__text > p:not(.eyebrow):not(.lede) {
    max-width: 52ch;
    color: #4a4643;
  }
  .stats {
    margin-inline: clamp(8px, 1.2vw, 16px);
    padding-block: clamp(36px, 5vw, 64px);
    border-radius: var(--r-lg);
    background: var(--rust);
    color: var(--white);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 16px;
    margin-block: 0;
  }
  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }
  .stats__item dd {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stats__item dt {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82);
  }
  .values__title {
    margin-bottom: clamp(24px, 4vw, 48px);
  }
  .values {
    display: grid;
    gap: 14px;
  }
  .values__card {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(20px, 2.6vw, 32px);
    border-radius: var(--r-md);
    background: var(--card);
  }
  .values__card p {
    color: #4a4643;
  }
  .values__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--rust);
    color: var(--white);
  }
  .gallery__head {
    display: grid;
    gap: 16px;
    margin-bottom: clamp(24px, 4vw, 48px);
  }
  .gallery {
    display: grid;
    gap: 14px;
  }
  .gallery > * {
    aspect-ratio: 16 / 10;
  }
  .tech {
    display: grid;
    gap: 24px;
    margin-top: clamp(32px, 5vw, 64px);
  }
  .tech li {
    display: grid;
    gap: 6px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .tech__num {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--rust);
  }
  .tech h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .tech p {
    font-size: 0.95rem;
    color: var(--muted);
  }
  @media (min-width: 640px) {
    .tech {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .values {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .story__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .gallery__head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
    }
    .gallery {
      grid-template-columns: 1.6fr 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .gallery > * {
      aspect-ratio: auto;
    }
    .gallery__a {
      grid-row: 1 / 3;
      min-height: 520px;
    }
    .tech {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
