---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Intro from '../components/Intro.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Showcase from '../components/Showcase.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { team } from '../data/team';
import { faqs } from '../data/content';

import heroSmile from '../assets/images/hero-smile.jpg';
import heroDetail from '../assets/images/hero-detail.jpg';
import servicesMain from '../assets/images/services-main.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.slice(0, 4);
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

const facilities = [
  { icon: 'braces', title: 'Braces', text: 'Braces are a time-tested solution for straightening teeth, correcting bite issues and improving overall oral health by gently applying pressure over time.', href: '/services/braces/' },
  { icon: 'aligner', title: 'Invisalign', text: 'Invisalign is a modern, discreet alternative to traditional braces, using a series of custom-made clear aligners to gently shift your teeth into perfect alignment.', href: '/services/invisalign/' },
  { icon: 'implant', title: 'Dental Implants', text: 'Dental implants replace missing teeth with a titanium root and a porcelain crown, placed with 3D-guided precision for a result that feels natural.', href: '/services/dental-implants/' },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__card">
      <div class="hero__media">
        <Image
          src={heroSmile}
          alt="Close-up of a bright, healthy smile"
          widths={[640, 960, 1280, 1680, 2200]}
          sizes="100vw"
          quality={72}
          loading="eager"
          fetchpriority="high"
          data-parallax="0.14"
        />
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <h1 class="hero__title h-display">
        <span data-split>Experienced dental</span>
        <em data-split data-delay="0.12">care professionals</em>
      </h1>

      <div class="hero__tooth three-slot" data-three="viewer" data-model="tooth" aria-hidden="true"></div>

      <div class="hero__hotspot" aria-hidden="true">
        <span class="hero__dot"></span>
        <span class="hero__line" data-draw></span>
      </div>

      <div class="hero__bottom">
        <div class="hero__lede">
          <p data-reveal>Our clinic offers a seamless blend of advanced technology and personalised treatment.</p>
          <div data-reveal><Button label="Book Appointment" href="/contact/" variant="light" /></div>
        </div>
        <a href="/services/" class="hero__glass" data-reveal>
          <span class="hero__glass-img">
            <Image src={heroDetail} alt="" widths={[240, 480]} sizes="220px" loading="eager" />
          </span>
          <span class="hero__glass-text">Refined dental treatments, tailored for you.</span>
        </a>
      </div>
    </div>
  </section>

  <Intro />

  <!-- Services -->
  <section class="section section--tight services" aria-labelledby="services-title">
    <div class="container">
      <div class="services__head">
        <p class="eyebrow" data-reveal>What we do</p>
        <h2 class="h-section" id="services-title" data-split>Our services</h2>
        <p class="lede" data-reveal>Everything your smile needs, delivered by one team under one roof.</p>
      </div>
      <div class="services__grid">
        <div class="media services__photo" data-img-reveal>
          <Image src={servicesMain} alt="Smiling patient during a gentle dental treatment" widths={[480, 760, 1100]} sizes="(min-width: 900px) 38vw, 92vw" loading="lazy" />
          <a href="/services/" class="services__badge">
            <strong>{services.length}</strong>
            <span>treatments under one roof</span>
            <span class="services__badge-icon"><Icon name="arrow-ur" /></span>
          </a>
        </div>
        <div class="svc-grid">
          {
            featured.map((s, i) => (
              <ServiceCard
                title={s.data.title}
                summary={s.data.summary}
                href={`/services/${s.id}/`}
                icon={s.data.icon}
                index={i}
                meta={`${s.data.price} · ${s.data.duration}`}
                featured={i === 0}
              />
            ))
          }
        </div>
      </div>
      <div class="services__more" data-reveal>
        <Button label="View All Services" href="/services/" variant="outline" />
      </div>
    </div>
  </section>

  <!-- Facilities -->
  <section class="fac on-rust" aria-labelledby="fac-title">
    <div class="container">
      <div class="fac__intro">
        <p data-reveal>Our modern dental facilities are thoughtfully equipped to provide you with the highest standard of care in a calming setting.</p>
        <p data-reveal>From state-of-the-art diagnostic tools and digital X-rays to ergonomic treatment rooms, everything is built around your comfort.</p>
      </div>
      <div class="fac__cards">
        {
          facilities.map((f, i) => (
            <div class:list={['fac__wrap', { 'fac__wrap--tilt': i === 1 }]} data-reveal="flip">
              <a href={f.href} class="fac__card" data-tilt>
                <Icon name={f.icon} />
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                <span class="fac__go">
                  Explore <Icon name="arrow" />
                </span>
              </a>
            </div>
          ))
        }
      </div>
      <h2 class="fac__title" id="fac-title" data-split>Our modern dental facilities</h2>
    </div>
  </section>

  <!-- 3D treatment showcase -->
  <div class="showcase-wrap"><Showcase /></div>

  <!-- Team -->
  <section class="section team" aria-labelledby="team-title">
    <div class="container team__stage">
      <div class="team__center">
        <h2 class="h-section" id="team-title" data-split>Our team of experts</h2>
        <div data-reveal><Button label="Book Appointment" href="/contact/" /></div>
      </div>
      <ul class="team__tiles">
        {
          team.map((d, i) => (
            <li class={`team__tile team__tile--${i + 1}`} data-reveal="zoom">
              <a href="/team/" data-parallax={[0.5, -0.35, 0.3, -0.5, 0.4, -0.3][i]}>
                <span class="media">
                  <Image src={d.photo} alt={`${d.name}, ${d.role}`} widths={[200, 320, 480]} sizes="(min-width: 900px) 16vw, 60vw" loading="lazy" />
                </span>
                <span class="team__cap">
                  <strong>{d.name}</strong>
                  <span>{d.role}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BeforeAfter />

  <!-- News -->
  <section class="section section--tight news" aria-labelledby="news-title">
    <div class="container">
      <div class="news__head">
        <h2 class="h-section" id="news-title" data-split>Dental news &amp; insights</h2>
        <div data-reveal><Button label="All Articles" href="/blog/" variant="outline" /></div>
      </div>
      <div class="news__grid">
        {
          posts.map((p) => (
            <ArticleCard title={p.data.title} href={`/blog/${p.id}/`} cover={p.data.cover} category={p.data.category} readTime={p.data.readTime} />
          ))
        }
      </div>
    </div>
  </section>

  <Testimonials />
  <Faq items={faqs.slice(0, 4)} />
  <CtaBand />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: var(--header-h) clamp(8px, 1.2vw, 16px) 0;
  }
  .hero__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: clamp(540px, calc(100svh - var(--header-h) - 16px), 860px);
    padding: clamp(20px, 3.4vw, 48px);
    overflow: hidden;
    border-radius: var(--r-lg);
    background: #5a2a17;
    color: var(--white);
  }
  .hero__media {
    position: absolute;
    inset: -8% 0;
  }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(40, 16, 6, 0.62) 0%, rgba(40, 16, 6, 0.08) 38%, rgba(40, 16, 6, 0) 55%, rgba(20, 8, 3, 0.78) 100%),
      linear-gradient(90deg, rgba(40, 16, 6, 0.3), transparent 60%);
  }
  .hero__title {
    position: relative;
    z-index: 2;
    text-shadow: 0 2px 30px rgba(40, 16, 6, 0.35);
  }
  .hero__title > * {
    display: block;
  }
  .hero__tooth {
    display: none;
  }
  .hero__hotspot {
    display: none;
  }
  .hero__bottom {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 18px;
  }
  .hero__lede {
    display: grid;
    gap: 16px;
    justify-items: start;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.4;
  }
  .hero__glass {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: var(--r-md);
    background: rgba(60, 30, 18, 0.55);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .hero__glass {
      background: rgba(255, 255, 255, 0.16);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }
  }
  .hero__glass-img {
    flex: none;
    width: 96px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
  }
  .hero__glass-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 640px) {
    .hero__tooth {
      display: block;
      position: absolute;
      z-index: 1;
      right: 3%;
      top: 4%;
      width: clamp(170px, 24vw, 330px);
      aspect-ratio: 1;
      filter: drop-shadow(0 30px 34px rgba(30, 10, 2, 0.45));
    }
  }
  @media (min-width: 900px) {
    .hero__bottom {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .hero__glass {
      flex-direction: column;
      align-items: stretch;
      width: 236px;
      padding: 12px;
    }
    .hero__glass-img {
      width: 100%;
    }
    .hero__hotspot {
      display: block;
      position: absolute;
      z-index: 1;
      left: 56%;
      top: 60%;
      right: calc(clamp(20px, 3.4vw, 48px) + 236px);
      bottom: calc(clamp(20px, 3.4vw, 48px) + 96px);
    }
    .hero__dot {
      position: absolute;
      left: -9px;
      top: -9px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--white);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
      animation: hotspot 2.2s ease-out infinite;
    }
    .hero__line {
      position: absolute;
      inset: 0;
      border-left: 1.5px solid rgba(255, 255, 255, 0.9);
      border-bottom: 1.5px solid rgba(255, 255, 255, 0.9);
    }
  }
  @keyframes hotspot {
    70%,
    100% {
      box-shadow: 0 0 0 18px rgba(255, 255, 255, 0);
    }
  }

  /* ---------- Services ---------- */
  .services__head {
    display: grid;
    gap: 14px;
    justify-items: center;
    margin-bottom: clamp(28px, 4vw, 56px);
    text-align: center;
  }
  .services__badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: calc(100% - 24px);
    padding: 8px 8px 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: rgba(60, 30, 18, 0.6);
    color: var(--white);
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.2;
    animation: badge-float 5.5s ease-in-out infinite;
  }
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .services__badge {
      background: rgba(255, 255, 255, 0.18);
      -webkit-backdrop-filter: blur(14px) saturate(1.3);
      backdrop-filter: blur(14px) saturate(1.3);
    }
  }
  .services__badge strong {
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1;
  }
  .services__badge-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    background: var(--white);
    color: var(--rust);
    transition: rotate 0.45s var(--ease);
  }
  .services__badge-icon :global(svg) {
    width: 15px;
    height: 15px;
  }
  .services__badge:hover .services__badge-icon {
    rotate: 45deg;
  }
  @keyframes badge-float {
    50% {
      transform: translateY(-7px);
    }
  }
  .services__grid {
    display: grid;
    gap: 14px;
  }
  .services__photo {
    aspect-ratio: 4 / 3;
  }
  .services__photo :global(img) {
    object-position: 50% 30%;
  }
  .svc-grid {
    display: grid;
    gap: 14px;
  }
  .services__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 3vw, 40px);
  }
  @media (min-width: 560px) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .services__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
      max-width: 1100px;
      margin-inline: auto;
    }
    .services__photo {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  /* ---------- Facilities ---------- */
  .fac {
    margin: clamp(32px, 5vw, 72px) clamp(8px, 1.2vw, 16px) 0;
    padding-block: clamp(48px, 7vw, 100px);
    border-radius: var(--r-lg);
    background: var(--rust);
    color: var(--white);
    overflow: hidden;
  }
  .fac__intro {
    display: grid;
    gap: 14px;
    color: rgba(255, 255, 255, 0.86);
  }
  .fac__intro p {
    max-width: 40ch;
  }
  .fac__cards {
    display: grid;
    gap: 16px;
    margin-block: clamp(32px, 5vw, 72px);
  }
  .fac__card {
    display: grid;
    align-content: start;
    gap: 10px;
    height: 100%;
    padding: clamp(20px, 2.4vw, 30px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r-md);
    transition:
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .fac__card :global(svg) {
    width: 40px;
    height: 40px;
  }
  .fac__card h3 {
    margin-top: 8px;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .fac__card p {
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.84);
  }
  .fac__card:hover,
  .fac__card:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--white);
  }
  .fac__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .fac__card .fac__go :global(svg) {
    width: 18px;
    height: 18px;
    transition: translate 0.4s var(--ease);
  }
  .fac__card:hover .fac__go :global(svg) {
    translate: 6px 0;
  }
  .fac__wrap--tilt {
    transform: rotate(-3deg);
  }
  .fac__wrap--tilt .fac__card {
    border-color: var(--white);
    border-width: 1.5px;
  }
  .fac__title {
    font-size: clamp(2.3rem, 9.4vw, 8.4rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    max-width: 11ch;
  }
  @media (min-width: 900px) {
    .fac__intro {
      grid-template-columns: 1fr 1fr;
      justify-items: start;
    }
    .fac__intro p:last-child {
      justify-self: end;
    }
    .fac__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
      align-items: center;
      max-width: 1120px;
      margin-inline: auto;
    }
    .fac__wrap--tilt {
      transform: rotate(-9deg) translateY(-12px);
    }
  }

  .showcase-wrap {
    margin-top: clamp(8px, 1.2vw, 16px);
  }

  /* ---------- Team ---------- */
  .team__center {
    display: grid;
    gap: 22px;
    justify-items: center;
    text-align: center;
  }
  .team__tiles {
    display: flex;
    gap: 14px;
    margin: 28px calc(var(--pad) * -1) 0;
    padding: 0 var(--pad) 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .team__tiles::-webkit-scrollbar {
    display: none;
  }
  .team__tile {
    flex: none;
    width: min(62vw, 250px);
    scroll-snap-align: center;
  }
  .team__tile a {
    display: grid;
    gap: 10px;
  }
  .team__tile .media {
    display: block;
    aspect-ratio: 1;
    background: #eef0ef;
  }
  .team__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    transition: transform 0.8s var(--ease);
  }
  .team__tile a:hover :global(img) {
    transform: scale(1.06);
  }
  .team__cap {
    display: grid;
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .team__cap span {
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .team__stage {
      position: relative;
      display: grid;
      place-items: center;
      min-height: clamp(560px, 50vw, 720px);
    }
    .team__center {
      position: relative;
      z-index: 1;
    }
    .team__tiles {
      position: absolute;
      inset: 0;
      display: block;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .team__tile {
      position: absolute;
    }
    .team__cap {
      position: absolute;
      left: 8px;
      right: 8px;
      bottom: 8px;
      padding: 8px 10px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.92);
      font-size: 0.78rem;
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.4s var(--ease),
        transform 0.4s var(--ease);
    }
    .team__tile a {
      position: relative;
      display: block;
    }
    .team__tile a:hover .team__cap,
    .team__tile a:focus-visible .team__cap {
      opacity: 1;
      transform: none;
    }
    /* tiles bob gently at different speeds */
    .team__tile .media {
      animation: team-float 6s ease-in-out infinite alternate;
    }
    .team__tile:nth-child(2n) .media {
      animation-duration: 7.5s;
      animation-delay: -2s;
    }
    .team__tile:nth-child(3n) .media {
      animation-duration: 9s;
      animation-delay: -4s;
    }
    .team__tile--1 { left: 3%; top: 6%; width: 14%; }
    .team__tile--2 { left: 27%; top: 0; width: 11.5%; }
    .team__tile--3 { right: 24%; top: 3%; width: 12.5%; }
    .team__tile--4 { right: 2%; top: 26%; width: 15%; }
    .team__tile--5 { left: 11%; bottom: 3%; width: 13.5%; }
    .team__tile--6 { right: 17%; bottom: 0; width: 12.5%; }
  }

  @keyframes team-float {
    from {
      transform: translateY(-9px) rotate(-1.5deg);
    }
    to {
      transform: translateY(9px) rotate(1.5deg);
    }
  }

  /* ---------- News ---------- */
  .news__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: clamp(28px, 4vw, 56px);
  }
  .news__grid {
    display: grid;
    gap: 32px 18px;
  }
  @media (min-width: 600px) {
    .news__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .news__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-bottom: 72px;
    }
    .news__grid > :global(:nth-child(2)) {
      margin-top: 72px;
      margin-bottom: -72px;
    }
    .news__grid > :global(:nth-child(1)),
    .news__grid > :global(:nth-child(3)) {
      margin-top: 0;
    }
    .news__grid > :global(:nth-child(1)) {
      margin-top: 36px;
    }
  }
</style>
