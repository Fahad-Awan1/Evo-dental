---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <section class="legal container">
    <p class="eyebrow">Legal</p>
    <h1 class="h-section">{title}</h1>
    <p class="legal__updated">Last updated: {updated}</p>
    <div class="prose"><slot /></div>
  </section>
</Base>

<style>
  .legal {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-block: calc(var(--header-h) + clamp(32px, 5vw, 72px)) clamp(64px, 8vw, 120px);
  }
  .legal__updated {
    margin-bottom: 16px;
    font-size: 0.92rem;
    color: var(--muted);
  }
</style>
